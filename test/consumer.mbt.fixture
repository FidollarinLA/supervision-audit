///|
fn document() -> @audit.Document {
  {
    contract: "causal-lm-unshifted-v1",
    allowed_roles: ["text"],
    samples: [{
      id: "external-sample",
      input_ids: [10, 11, 0],
      labels: [-100, 11, -100],
      attention_mask: [1, 1, 0],
      spans: [{ start: 0, end: 3, role: "text" }],
      segments: [{ start: 0, end: 3, source_id: "synthetic" }],
      original_supervised_tokens: None,
    }],
  }
}

///|
test "external consumer reads typed reports and comparison evidence" {
  let healthy = document()
  let after = @audit.audit(healthy)
  assert_eq(after.status, "pass")
  assert_eq(after.schema_version, "supervision-audit/report/v1")
  assert_eq(after.prediction_targets, Some(1))
  let broken = document()
  broken.samples[0].labels[2] = 0
  let before = @audit.audit(broken)
  assert_eq(before.status, "fail")
  assert_true(before.findings.any(f => f.code == "PADDING_SUPERVISED"))
  let delta = @audit.compare(before, after)
  assert_eq(delta.schema_version, "supervision-audit/comparison/v1")
  assert_eq(delta.new_findings.length(), 0)
  assert_true(delta.resolved_findings.any(f => f.code == "PADDING_SUPERVISED"))
}

///|
test "external consumer can use JSON and JSONL bridges" {
  let report = @json.parse(@audit.audit_json(document().to_json().stringify()))
  assert_true(report is { "ok": true, "report": { "status": "pass", .. }, .. })
  let row = "{\"input_ids\":[10,11],\"labels\":[-100,11],\"attention_mask\":[1,1]}"
  let normalized = @json.parse(@audit.audit_jsonl(row, "[\"text\"]"))
  assert_true(normalized is { "ok": true, "report": { "status": "review", .. }, .. })
  let text = document().to_json().stringify()
  let compared = @json.parse(@audit.compare_json(text, text))
  assert_true(compared is { "ok": true, "comparison": { "new_findings": [], .. }, .. })
}

///|
test "published source identifiers cannot bypass provenance checks" {
  let doc = document()
  doc.samples[0].segments[0] = { start: 0, end: 3, source_id: "unknown" }
  assert_eq(@audit.audit(doc).status, "pass")
  doc.samples[0].segments.push({ start: 0, end: 1, source_id: "other" })
  let report = @audit.audit(doc)
  assert_eq(report.status, "fail")
  assert_true(report.findings.any(f => f.code == "SOURCE_OVERLAP"))
}
